{
    "name": "kba-team/memory-container",
    "description": "PSR-11 container storing its values in memory and offering a singleton access.",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/the-kbA-team/memory-container/issues"
    },
    "keywords": [
        "PSR-11",
        "container",
        "in-memory",
        "singleton"
    ],
    "minimum-stability": "stable",
    "provide": {
        "psr/container-implementation": "^2.0"
    },
    "require": {
        "php": "^8.1",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "kbATeam\\MemoryContainer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\kbATeam\\MemoryContainer\\": "tests/"
        }
    }
}
